# Shop Management System Environment Configuration
# PostgreSQL Database URLs (asyncpg for async FastAPI, psycopg2 for synchronous Alembic)
DATABASE_URL=postgresql+asyncpg://postgres:your_password@localhost:5432/shop_manage_db
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:your_password@localhost:5432/shop_manage_db

# Security & JWT Configuration
SECRET_KEY=generate_a_random_secure_hex_key_here_or_use_default
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Project Settings
PROJECT_NAME=Shop Management System
API_V1_STR=/api

# AI Assistant Configuration (Optional)
# AI_PROVIDER options: "gemini", "local", "fallback"
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Local AI Configuration (e.g. Ollama or OpenAI-compatible endpoint)
LOCAL_AI_BASE_URL=http://localhost:11434/v1
LOCAL_AI_MODEL=llama3
